{
  "manifest_version": 3,
  "name": "Workflow Navigator",
  "version": "0.2.0",
  "description": "Hierarchical, searchable view of GitHub Actions workflows for monorepos.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*", "https://github.com/*/*/**"],
      "js": [
        "src/parser.js",
        "src/api.js",
        "src/cache.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Workflow Navigator settings"
  },
  "options_page": "src/options.html"
}
